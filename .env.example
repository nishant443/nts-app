# ---------------------------------------------------------------------------
# Nutan Tech Solutions — environment template
# Copy to `.env` and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#   Local dev:  npm run db:start  (prints a postgres:// URL on a random port)
#   Production: Neon / Supabase / Render — remember ?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/nts?schema=public"

# Signs the session JWT (HS256). Rotate to force-log-out every user.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=""

# Absolute URL of the app, used in emails and PDF asset links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File storage driver: "local" writes to ./storage (development only),
# "cloudinary" uploads to the account configured below.
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Outbound email — optional. Leave SMTP_HOST blank and the "Email" buttons on
# quotations and invoices explain that mail is not set up instead of failing.
# Gmail: host smtp.gmail.com, port 465, secure true, and an app password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# The From address, e.g. "Nutan Tech Solutions <sales@ntss.co.in>"
SMTP_FROM=""
